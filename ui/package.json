{
  "name": "@task-board/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "generate:themes": "node scripts/generate-theme-manifest.mjs",
    "prestart": "npm run generate:themes",
    "start": "ng serve",
    "prebuild": "npm run generate:themes",
    "build": "ng build",
    "pretest": "npm run generate:themes",
    "test": "ng test --no-watch",
    "pretest:verbose": "npm run generate:themes",
    "test:verbose": "ng test --no-watch --reporters=verbose",
    "pree2e": "npm run generate:themes",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "analyze": "ng build --configuration production --stats-json && esbuild-visualizer --metadata dist/ui/stats.json --filename dist/ui/stats.html && xdg-open dist/ui/stats.html"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@spartan-ng/brain": "^1.3.0",
    "@task-board/shared": "*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@playwright/test": "^1.62.0",
    "@spartan-ng/cli": "^1.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "angular-eslint": "^22.1.0",
    "esbuild-visualizer": "^0.7.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.10"
  }
}
