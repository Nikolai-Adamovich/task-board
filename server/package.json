    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@task-board/shared": "*",
    "bcryptjs": "^3.0.3",
    "hono": "^4.8.0",
    "mongodb": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250712.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "~6.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
